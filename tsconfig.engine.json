{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo"
  },
  "include": [
    "src/combat",
    "src/narrative",
    "src/personality",
    "src/dialogue",
    "src/state",
    "src/types",
    "src/fixtures",
    "src/session",
    "src/persistence",
    "tests"
  ]
}
